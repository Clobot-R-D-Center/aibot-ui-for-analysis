{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"build": {
			"outputs": ["dist/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"passThroughEnv": [
				"FLEET_ADAPTER",
				"WS_PORT",
				"HISTORY_DB",
				"HISTORY_DAYS"
			]
		},
		"test": {}
	}
}
